{
  "name": "ainovelist",
  "version": "0.1.0",
  "description": "Local-first AI novel writing desktop workbench",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "run-s typecheck build:web tauri:build",
    "build:web": "vite build",
    "tauri:build": "tauri build",
    "typecheck": "run-s typecheck:app typecheck:packages",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:packages": "run-s typecheck:schema typecheck:core",
    "typecheck:schema": "tsc --noEmit -p packages/schema/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "build:packages": "run-s build:schema build:core",
    "build:schema": "tsc -p packages/schema/tsconfig.json",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "test": "vitest run",
    "test:ai": "python services/ai/ainovelist_ai_service.py generate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "npm-run-all2": "^7.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
